# MySQL Database Settings
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflowpass123
MYSQL_PORT=3306

# Backend Application Settings
PORT=5000
DATABASE_URL=mysql+pymysql://taskflow:taskflowpass123@db:3306/taskflow
ROOT_ARCHITECT_EMAIL=admin@example.com
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production
CORS_ORIGINS=*

# Port Mapping (Host Ports)
# For Local Dev: BACKEND_PORT=5001, FRONTEND_PORT=8080, DB_UI_PORT=8081
# For EC2 Prod:  BACKEND_PORT=5000, FRONTEND_PORT=80, DB_UI_PORT=8081
BACKEND_PORT=5001
FRONTEND_PORT=8080
DB_UI_PORT=8081

# MySQL Database Settings
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=your_secure_app_password_here
MYSQL_PORT=3306

# Backend Application Settings
PORT=5000
DATABASE_URL=mysql+pymysql://taskflow:your_secure_app_password_here@db:3306/taskflow
ROOT_ARCHITECT_EMAIL=admin@example.com
JWT_SECRET=your_jwt_secret_random_hex_string_here
CORS_ORIGINS=*

# Port Mapping (Host Ports)
# For Local Dev: BACKEND_PORT=5001, FRONTEND_PORT=8080, DB_UI_PORT=8081
# For EC2 Prod:  BACKEND_PORT=5000, FRONTEND_PORT=80, DB_UI_PORT=8081
BACKEND_PORT=5001
FRONTEND_PORT=8080
DB_UI_PORT=8081
